digraph DFA_Parties {
    rankdir=LR;
    size="10,5";

    // États finaux
    node [shape=doublecircle];
    F G;

    // États non finaux
    node [shape=circle];
    A B C D E;

    // État initial
    init [shape=point];
    init -> A;

    // Transitions
    A -> B [label="a"];
    A -> C [label="b"];

    B -> D [label="a"];
    B -> C [label="b"];

    C -> E [label="a"];
    C -> C [label="b"];

    D -> D [label="a"];
    D -> F [label="b"];

    E -> G [label="a"];
    E -> C [label="b"];

    F -> E [label="a"];
    F -> C [label="b"];

    G -> D [label="a"];
    G -> F [label="b"];
}
