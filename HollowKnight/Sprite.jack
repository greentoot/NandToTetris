    function void draw(int x, int y, int facing, int frame) {
        var Array screen;
        var int row, col, source, pixel, address, m, v;
        do Sprite.load(frame, facing);
        let screen = 16384;
        let x = x - 24;
        let source = 0;
        let row = 0;
        while (row < 48) {
            let col = 0;
            while (col < 10) {
                let pixel = x + (col * 8);
                let m = mask[source];
                if ((~(m = 0)) & (pixel > -1) & (pixel < 512)) {
                    let v = ink[source];
                    let address = ((y + row) * 32) + (pixel / 16);
                    if ((pixel & 8) = 8) {
                        let m = m * 256;
                        let v = v * 256;
                    }
                    let screen[address] = (screen[address] & (~m)) | v;
                }
                let source = source + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }
