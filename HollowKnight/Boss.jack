    function void draw(int x, int y, int facing, int frame) {
        var Array screen;
        var int row, col, source, pixel, address, m, v;
        let screen = 16384;
        let source = ((facing * 2) + frame) * 384;
        let row = 0;
        while (row < 64) {
            let col = 0;
            while (col < 6) {
                let m = mask[source];
                if (~(m = 0)) {
                    let v = ink[source];
                    let pixel = x + (col * 8);
                    let address = ((y + row) * 32) + (pixel / 16);
                    if ((pixel & 8) = 8) {
                        let m = m * 256;
                        let v = v * 256;
                    }
                    let screen[address] = (screen[address] & (~m)) | v;
                }
                let source = source + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }
