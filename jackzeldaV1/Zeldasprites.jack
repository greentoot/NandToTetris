class Zeldasprites {
function void drawzelda(int location) {
	var int memAddress; 
	let memAddress = 16384+location;
	// column 0
	do Memory.poke(memAddress, 8176);
	do Memory.poke(memAddress +32, 8200);
	do Memory.poke(memAddress +64, 20452);
	do Memory.poke(memAddress +96, -20454);
